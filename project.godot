; Engine configuration file.
; Riftline is intentionally portrait-free: a competitive shooter needs a stable landscape grip.
config_version=5

[application]

; The game is "Swing or Get Swung"; the home-screen label under the app icon is
; the short form, because a full title does not fit there.
config/name="SOGS"
run/main_scene="res://main.tscn"
config/icon="res://icons/icon_1024.png"
config/features=PackedStringArray("4.7", "Mobile")
; Competitive target: render and simulate at 120 Hz where the display allows.
run/max_fps=120

[display]

[display/window]
size/viewport_width=1280
size/viewport_height=588
size/window_width_override=1280
size/window_height_override=588
size/resizable=true
stretch/mode="canvas_items"
stretch/aspect="expand"
; Follow the device sensor while remaining landscape-only, including reverse landscape grip.
handheld/orientation=4

[display/window/ios]

; Let ProMotion displays run the game above 60 Hz instead of clamping to it.
enable_high_refresh_rate=true

[physics]

common/physics_ticks_per_second=120

[input]

move_forward={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":87)]
}
move_back={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":83)]
}
move_left={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":65)]
}
move_right={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":68)]
}
fire={
"deadzone": 0.5,
"events": [Object(InputEventMouseButton,"button_index":1)]
}
jump={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":32)]
}
reload={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":82)]
}
interact={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":70)]
}
melee={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":86)]
}

[input_devices]

; Touches already arrive as ScreenTouch events for the custom HUD.
; Emulating a mouse click as well turns any movement touch into a held fire input.
pointing/emulate_mouse_from_touch=false

[rendering]

; Nuclear Rush targets a realistic, Halo-Infinite-adjacent look on iOS hardware.
; The Mobile renderer stays: Forward+ would unlock SSAO/SSIL/SDFGI/SSR and
; volumetric fog, but none of them are affordable at 120 Hz on a phone. The
; realism budget is spent instead on true metal-roughness materials
; (`shaders/nuclear_pbr.gdshader`), sky-sourced ambient and reflection, ACES
; tonemapping, high-resolution soft shadows and bloom - all of which the Mobile
; renderer does support.
renderer/rendering_method="mobile"
renderer/rendering_method.mobile="mobile"
; iOS accepts only projects that prepare portable ETC2/ASTC texture data.
textures/vram_compression/import_etc2_astc=true
textures/default_filters/use_nearest_mipmap_filter=false
; Anisotropic filtering keeps the procedural floor relief from smearing at
; grazing angles, which is where a flat-looking floor gives the style away.
textures/default_filters/anisotropic_filtering_level=2
lights_and_shadows/directional_shadow/size=4096
lights_and_shadows/directional_shadow/size.mobile=2048
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=3
lights_and_shadows/directional_shadow/soft_shadow_filter_quality.mobile=2
lights_and_shadows/positional_shadow/atlas_size=4096
lights_and_shadows/positional_shadow/atlas_size.mobile=2048
lights_and_shadows/positional_shadow/soft_shadow_filter_quality=3
lights_and_shadows/positional_shadow/soft_shadow_filter_quality.mobile=2
; Per-pixel shading is the whole point of a PBR pass - never fall back to
; per-vertex, which the mobile preset is otherwise willing to do.
shading/overrides/force_vertex_shading=false
; 2x MSAA is the most edge quality that still holds 120 Hz on ProMotion parts.
anti_aliasing/quality/msaa_3d=1
anti_aliasing/quality/screen_space_aa=0
; Cleared to the sky's horizon value so the frame never flashes flat blue.
environment/defaults/default_clear_color=Color(0.0784314, 0.0862745, 0.101961, 1)
